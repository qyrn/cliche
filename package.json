{
  "name": "cliche",
  "version": "0.2.0",
  "description": "Captures d'écran rapides pour KDE Plasma Wayland, avec historique et OCR local",
  "author": "qyrn",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "native": "sh scripts/build-native.sh",
    "dev": "pnpm native && electron-vite dev",
    "build": "pnpm native && electron-vite build",
    "build:linux": "pnpm build && electron-builder --linux",
    "install:linux": "pnpm build:linux && sh scripts/install-linux.sh",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "dev.qyrn.cliche",
    "productName": "cliche",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/tray",
        "to": "tray"
      }
    ],
    "linux": {
      "target": [
        "dir",
        "pacman"
      ],
      "icon": "resources/icon.png",
      "category": "Utility",
      "executableName": "cliche",
      "synopsis": "Captures d'écran rapides pour KDE Plasma Wayland",
      "maintainer": "qyrn",
      "desktop": {
        "entry": {
          "Name": "cliché",
          "Keywords": "screenshot;capture;ocr;",
          "StartupWMClass": "cliche",
          "Actions": "capture;"
        },
        "desktopActions": {
          "capture": {
            "Name": "Capturer une zone",
            "Exec": "cliche --capture"
          }
        }
      },
      "description": "Captures d'écran avec historique et lecture du texte"
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libcups",
        "libnotify",
        "mesa",
        "libxkbcommon",
        "systemd-libs",
        "glib2",
        "wl-clipboard",
        "tesseract",
        "tesseract-data-fra",
        "tesseract-data-eng"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
